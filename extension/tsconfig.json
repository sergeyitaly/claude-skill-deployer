{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node16",
    "types": ["node", "vscode"]
  },
  "exclude": ["node_modules", ".vscode-test", "out", "src/**/*.test.ts", "vitest.config.ts"]
}
