{
  "name": "claude-skill-deployer",
  "displayName": "Claude Skills Manager",
  "description": "Detect project stack and deploy AI agent skills (Claude, Cursor, Kiro, Copilot) with budget controls, branch profiles, and usage reports.",
  "version": "1.0.18",
  "publisher": "serhiivoinolovych",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergeyitaly/claude-skill-deployer.git"
  },
  "bugs": {
    "url": "https://github.com/sergeyitaly/claude-skill-deployer/issues"
  },
  "homepage": "https://github.com/sergeyitaly/claude-skill-deployer#readme",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "cursor",
    "skills",
    "skill manager",
    "copilot",
    "kiro",
    "ai agents",
    "budget",
    "cost"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSkills",
          "title": "Claude Skills",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "claudeSkills": [
        {
          "id": "claudeSkillsView",
          "name": "Skills Library"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSkills.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.pickWorkspaceFolder",
        "title": "Pick Active Workspace Folder",
        "icon": "$(root-folder)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installLibraryToGlobal",
        "title": "Install Skill Library to ~/.claude/skills",
        "icon": "$(cloud-download)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.generateForWorkspace",
        "title": "Install Relevant Skills for Workspace",
        "icon": "$(check)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.generateAllForWorkspace",
        "title": "Install All Skills for Workspace",
        "icon": "$(checklist)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.previewForWorkspace",
        "title": "Preview Skill Detection (Dry Run)",
        "icon": "$(eye)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installSkillToWorkspace",
        "title": "Install to Workspace .claude/skills",
        "icon": "$(arrow-down)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.openSkill",
        "title": "Open SKILL.md",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.disableSkillLocally",
        "title": "Disable Skill Locally (this workspace only)",
        "icon": "$(eye-closed)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.enableSkillLocally",
        "title": "Enable Skill Locally",
        "icon": "$(eye)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.showUsageStats",
        "title": "Show Skill Usage Report",
        "icon": "$(graph)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installSessionWatchHook",
        "title": "Enable Session Size Notifications",
        "icon": "$(bell-dot)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installAttributionHooks",
        "title": "Enable Attribution Hooks (v2)",
        "icon": "$(graph)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.exportTeamBranchProfile",
        "title": "Export Team Branch Profile to Git",
        "icon": "$(repo)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.applyTeamBranchProfile",
        "title": "Apply Team Branch Profile from Git",
        "icon": "$(repo-sync)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.showTeamBranchProfiles",
        "title": "Show Team Branch Profiles (Git)",
        "icon": "$(repo)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installCostControlHooks",
        "title": "Enable Cost Control Hooks (Budget + Session + Focus)",
        "icon": "$(shield)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installOfficialSkillsSessionHook",
        "title": "Enable Official Skills Session Check (SessionStart)",
        "icon": "$(cloud-download)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.checkOfficialSkillUpdates",
        "title": "Check Official Anthropic Skill Updates",
        "icon": "$(cloud-download)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.cycleBudgetMode",
        "title": "Cycle Budget Mode (Economy / Normal / Unlimited)",
        "icon": "$(settings-gear)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.cycleContextFocusLevel",
        "title": "Cycle Context Focus Level (Knowledge / Balanced / Local / Strict)",
        "icon": "$(target)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.openContextFocusSettings",
        "title": "Open Context Focus Settings",
        "icon": "$(settings)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.cyclePracticalFocusLevel",
        "title": "Cycle Practical Focus (Theory / Architecture / Deploy-ready)",
        "icon": "$(rocket)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.openPracticalFocusSettings",
        "title": "Open Practical Focus Settings",
        "icon": "$(settings)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.openBudgetSettings",
        "title": "Open Budget Settings",
        "icon": "$(settings)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.openExtensionSettings",
        "title": "Open Extension Settings",
        "icon": "$(settings-gear)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.saveBranchProfile",
        "title": "Save Branch Skill Profile",
        "icon": "$(save)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.applyBranchProfile",
        "title": "Apply Branch Skill Profile",
        "icon": "$(repo-sync)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.showBranchProfiles",
        "title": "Show Branch Skill Profiles",
        "icon": "$(git-branch)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installLibraryToAllAgents",
        "title": "Install Skill Library to All Enabled AI Agents",
        "icon": "$(layers)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.showAgentCapabilities",
        "title": "Show Enabled AI Agent Targets",
        "icon": "$(list-tree)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.syncWorkspaceToAgents",
        "title": "Sync Workspace Skills to All Agents",
        "icon": "$(sync)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.showCostDashboard",
        "title": "Show Cost Intelligence Dashboard",
        "icon": "$(dashboard)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.showOptimizationSuggestions",
        "title": "Show Cost Optimization Suggestions",
        "icon": "$(lightbulb-autofix)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.applyOptimizations",
        "title": "Apply Cost Optimizations",
        "icon": "$(wand)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.exportCostReport",
        "title": "Export Cost Report",
        "icon": "$(export)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.installCommitCostHook",
        "title": "Enable Git Commit Cost Tracking",
        "icon": "$(git-commit)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.manageFeatures",
        "title": "Manage Feature Toggles",
        "icon": "$(settings-gear)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.resetEmergencyCutoff",
        "title": "Reset Emergency Cost Cutoff",
        "icon": "$(warning)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.cycleSkillSort",
        "title": "Cycle Skill Sort (ROI / Cost)",
        "icon": "$(sort-precedence)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.estimatePRCost",
        "title": "Estimate PR Review Cost",
        "icon": "$(git-pull-request)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.restoreArchivedSkill",
        "title": "Restore Archived Skill",
        "icon": "$(history)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.startOnboarding",
        "title": "Open Setup Wizard",
        "icon": "$(rocket)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.startOnboardingTour",
        "title": "Start Onboarding Tour (step prompts)",
        "icon": "$(list-ordered)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.repairData",
        "title": "Repair Claude Skills Data",
        "icon": "$(wrench)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.resetAttribution",
        "title": "Reset Mis-attributed Cost Data",
        "icon": "$(debug-restart)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.configureWeeklyReportEmail",
        "title": "Configure Weekly Report Email",
        "icon": "$(key)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.sendWeeklyReport",
        "title": "Send Weekly AI Usage Report",
        "icon": "$(mail)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.runSkillSetResolver",
        "title": "Run Skill Set Resolver Now",
        "icon": "$(sync)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.previewSkillSetResolver",
        "title": "Preview Skill Set Resolver",
        "icon": "$(eye)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.setPosition",
        "title": "Set Your Position (local profile)",
        "icon": "$(person)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.refreshSkillCatalog",
        "title": "Refresh Skill Catalog for Agent",
        "icon": "$(refresh)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.initProfile",
        "title": "Init Profile for Current Branch",
        "icon": "$(account)",
        "category": "Claude Skills"
      },
      {
        "command": "claudeSkills.applyLocalProfile",
        "title": "Apply Local Profile (.claude/profile.local.json)",
        "icon": "$(check)",
        "category": "Claude Skills"
      }
    ],
    "configuration": [
      {
        "id": "claudeSkillsManager",
        "title": "Claude Skills Manager",
        "order": 0,
        "properties": {
          "claudeSkills.officialSkillsCheckOnSession": {
            "type": "boolean",
            "default": true,
            "description": "When skills_library/ exists, install a Claude Code SessionStart hook that checks anthropics/skills for updates and prompts skill-official-updater."
          },
          "claudeSkills.preferLocalSkillOverrides": {
            "type": "boolean",
            "default": true,
            "description": "When unchecking a skill committed on the current branch, disable it locally via .claude/settings.local.json instead of deleting .claude/skills/ (no git diff)."
          }
        }
      },
      {
        "id": "budget",
        "title": "Budget",
        "order": 1,
        "properties": {
          "claudeSkills.budget.autoDisableHighTier": {
            "type": "boolean",
            "default": true,
            "description": "When the daily budget is exceeded, auto-disable high-tier skills locally via skillOverrides."
          },
          "claudeSkills.budget.dailyBudgetUsd": {
            "type": "number",
            "default": 5,
            "minimum": 0,
            "description": "Daily estimated spend cap in USD (0 disables the cap). Uses transcript-based estimates, not an actual bill."
          },
          "claudeSkills.budget.economyWarnUsd": {
            "type": "number",
            "default": 0.1,
            "minimum": 0,
            "description": "In economy mode, warn once per day when today's estimated spend crosses this USD amount."
          },
          "claudeSkills.budget.mode": {
            "type": "string",
            "enum": [
              "economy",
              "normal",
              "unlimited"
            ],
            "enumDescriptions": [
              "Disable high-tier skills locally and warn at low spend thresholds.",
              "Warn at 80% of daily budget; auto-disable high-tier skills when budget is exceeded.",
              "No restrictions; notify once per day at a high spend threshold."
            ],
            "default": "normal",
            "description": "Token budget mode across all Claude Code projects on this machine."
          },
          "claudeSkills.budget.unlimitedNotifyUsd": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "description": "In unlimited mode, notify once per day when today's estimated spend crosses this USD amount."
          },
          "claudeSkills.budget.warnThresholdPercent": {
            "type": "number",
            "default": 80,
            "minimum": 0,
            "maximum": 100,
            "description": "Warn when today's estimated spend reaches this percentage of the daily budget."
          }
        }
      },
      {
        "id": "contextFocus",
        "title": "Context Focus",
        "order": 1.5,
        "properties": {
          "claudeSkills.contextFocus.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Inject grounding instructions via the context-focus hook to balance local workspace context vs general LLM knowledge."
          },
          "claudeSkills.contextFocus.level": {
            "type": "string",
            "enum": [
              "knowledge",
              "balanced",
              "local-first",
              "strict-local"
            ],
            "enumDescriptions": [
              "Prefer general LLM knowledge; read workspace files when editing or when asked about this repo.",
              "Verify repo-specific facts in files; use general knowledge for concepts (recommended default).",
              "Read and cite workspace files before claiming how this project works; load only task-relevant skills.",
              "Only assert facts from read files, user input, or tool output — say uncertain rather than guess."
            ],
            "default": "balanced",
            "description": "How strongly to prioritize verified local workspace context over general model knowledge."
          },
          "claudeSkills.contextFocus.autoEscalateOnSessionSize": {
            "type": "boolean",
            "default": true,
            "description": "When the session transcript grows large, automatically tighten context focus (warn: one step stricter; critical: strict-local)."
          },
          "claudeSkills.contextFocus.injectEveryPrompt": {
            "type": "boolean",
            "default": true,
            "description": "Inject grounding on every prompt. When false, inject once per session plus whenever the session is large."
          },
          "claudeSkills.contextFocus.limitSkillCatalogHints": {
            "type": "boolean",
            "default": true,
            "description": "When many skills are installed and focus is local-first or strict-local, remind the agent to load only task-relevant skills."
          },
          "claudeSkills.contextFocus.manySkillsThreshold": {
            "type": "number",
            "default": 12,
            "minimum": 1,
            "description": "Installed skill count at which catalog-limit hints apply."
          }
        }
      },
      {
        "id": "practicalFocus",
        "title": "Practical / Deployment Focus",
        "order": 1.6,
        "properties": {
          "claudeSkills.practicalFocus.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Inject deployment-first guidance via hook — concrete architecture and first-try deploy steps instead of theoretical advice."
          },
          "claudeSkills.practicalFocus.level": {
            "type": "string",
            "enum": [
              "exploratory",
              "balanced",
              "architecture-first",
              "deploy-ready"
            ],
            "enumDescriptions": [
              "Trade-offs and theory are fine — early design discussions.",
              "Mix theory with concrete next steps tied to this repo.",
              "Concrete architecture and IaC aligned with repo patterns; read infra before advising (recommended when enabling).",
              "Every answer must be first-try deployable: exact commands, prereqs, validation, rollback."
            ],
            "default": "architecture-first",
            "description": "How strongly to favor provisionable architecture over hand-wavy theoretical recommendations."
          },
          "claudeSkills.practicalFocus.injectEveryPrompt": {
            "type": "boolean",
            "default": true,
            "description": "Inject on every prompt. When false, inject once per session."
          },
          "claudeSkills.practicalFocus.recommendDeploymentSkill": {
            "type": "boolean",
            "default": true,
            "description": "At architecture-first and deploy-ready, remind the agent to read the deployment-practical skill."
          },
          "claudeSkills.practicalFocus.requireValidationSteps": {
            "type": "boolean",
            "default": true,
            "description": "At deploy-ready, require validation commands before marking deployment tasks complete."
          }
        }
      },
      {
        "id": "branchProfiles",
        "title": "Branch Profiles",
        "order": 2,
        "properties": {
          "claudeSkills.branchProfiles.autoApplyOnSwitch": {
            "type": "boolean",
            "default": true,
            "description": "When switching git branches, install skills from the saved profile for the new branch."
          },
          "claudeSkills.branchProfiles.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Store per-git-branch skill layouts in ~/.claude/learning/branch-profiles.json."
          },
          "claudeSkills.branchProfiles.removeExtraOnApply": {
            "type": "boolean",
            "default": false,
            "description": "When applying a branch profile, remove personal-only skills (not on the branch) that are not in the profile. Branch-committed skills are disabled via skillOverrides instead of deleted."
          },
          "claudeSkills.branchProfiles.teamProfilePath": {
            "type": "string",
            "default": ".claude/skills-profile.json",
            "description": "Git-committed team skill layout per branch (export with Export Team Branch Profile to Git)."
          }
        }
      },
      {
        "id": "profileInit",
        "title": "Profile Init",
        "order": 2.5,
        "properties": {
          "claudeSkills.profileInit.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Role-based skill profile init: agent picks skills from the live catalog per branch (stored locally, not committed)."
          },
          "claudeSkills.profileInit.promptOnNewBranch": {
            "type": "boolean",
            "default": true,
            "description": "When switching to a git branch with no saved skill profile, prompt to run profile init."
          },
          "claudeSkills.profileInit.autoApplyProfileFile": {
            "type": "boolean",
            "default": true,
            "description": "When the agent writes .claude/profile.local.json, automatically install the selected skills."
          },
          "claudeSkills.profileInit.autoStartOnSession": {
            "type": "boolean",
            "default": true,
            "description": "Install a Claude Code SessionStart hook and sync profile-init to all agents when a branch profile request is pending."
          }
        }
      },
      {
        "id": "agents",
        "title": "Agents",
        "order": 3,
        "properties": {
          "claudeSkills.agents.enabled": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "claude",
                "cursor",
                "kiro",
                "copilot"
              ]
            },
            "default": [
              "claude",
              "cursor",
              "kiro",
              "copilot"
            ],
            "description": "AI agents that receive skill clones from this library (see skills_library/agents.json). Includes copilot (.github/instructions)."
          },
          "claudeSkills.agents.syncGlobalToAll": {
            "type": "boolean",
            "default": true,
            "description": "When installing the global library, sync to all enabled agents instead of Claude only. Requires claudeSkills.features.multiAgent."
          },
          "claudeSkills.agents.syncHooksOnSkillChange": {
            "type": "boolean",
            "default": true,
            "description": "When workspace skills change, refresh hook scripts in .claude/hooks/ (cost-control hooks only if already enabled). Attribution v2 hooks are controlled by autoInstallAttributionHooks."
          },
          "claudeSkills.agents.autoInstallAttributionHooks": {
            "type": "boolean",
            "default": true,
            "description": "Automatically install Attribution v2 hooks (PostToolUse/postToolUse Skill invoke logging) for Claude, Cursor, Kiro, and Copilot when the extension activates or workspace skills change."
          },
          "claudeSkills.agents.syncWorkspaceToAll": {
            "type": "boolean",
            "default": true,
            "description": "When installing workspace skills, deploy to all enabled agent paths (.claude, .cursor, .kiro, .github/instructions). Requires claudeSkills.features.multiAgent."
          }
        }
      },
      {
        "id": "features",
        "title": "Features",
        "order": 4,
        "properties": {
          "claudeSkills.features.attributionCollector": {
            "type": "boolean",
            "default": true,
            "description": "Background transcript attribution collector."
          },
          "claudeSkills.features.autoOptimizer": {
            "type": "boolean",
            "default": false,
            "description": "Enable the auto-optimizer timer (off by default; turn on only after attribution looks reliable)."
          },
          "claudeSkills.features.branchProfiles": {
            "type": "boolean",
            "default": true,
            "description": "Per-git-branch skill profiles."
          },
          "claudeSkills.features.budgetControls": {
            "type": "boolean",
            "default": true,
            "description": "Daily budget, economy mode, and cost control hooks."
          },
          "claudeSkills.features.communityBenchmarks": {
            "type": "boolean",
            "default": false,
            "description": "Community cost benchmarks (opt-in telemetry)."
          },
          "claudeSkills.features.costAwareSearch": {
            "type": "boolean",
            "default": true,
            "description": "Show ROI/cost in skills tree and enable cost-based sorting."
          },
          "claudeSkills.features.skillSetResolver": {
            "type": "boolean",
            "default": true,
            "description": "Enable the weekly skill set resolver scheduler (also requires claudeSkills.skillSetResolver.enabled)."
          },
          "claudeSkills.features.contextFocus": {
            "type": "boolean",
            "default": true,
            "description": "Context focus level toggle and grounding hook to reduce hallucination in long sessions."
          },
          "claudeSkills.features.practicalFocus": {
            "type": "boolean",
            "default": true,
            "description": "Practical/deployment focus toggle — architecture and first-try deploy steps over theoretical advice."
          },
          "claudeSkills.features.costIntelligence": {
            "type": "boolean",
            "default": true,
            "description": "Cost dashboard, optimization suggestions, and reports."
          },
          "claudeSkills.features.emergencyCutoff": {
            "type": "boolean",
            "default": true,
            "description": "Hard daily spend cutoff that disables all workspace skills."
          },
          "claudeSkills.features.multiAgent": {
            "type": "boolean",
            "default": true,
            "description": "Deploy skills to Cursor, Kiro, and Copilot."
          },
          "claudeSkills.features.prCostEstimate": {
            "type": "boolean",
            "default": false,
            "description": "GitHub PR cost estimate via gh CLI."
          },
          "claudeSkills.features.predictiveAlerts": {
            "type": "boolean",
            "default": true,
            "description": "Weekly trend warnings when spend is projected over budget."
          },
          "claudeSkills.features.skillArchival": {
            "type": "boolean",
            "default": true,
            "description": "Archive idle expensive skills to .claude/skills-archived/."
          },
          "claudeSkills.features.teamCostSharing": {
            "type": "boolean",
            "default": true,
            "description": "Attribute skill cost to git authors in shared .claude/skills/."
          }
        }
      },
      {
        "id": "lint",
        "title": "Lint",
        "order": 5,
        "properties": {
          "claudeSkills.lint.blockSyncOnError": {
            "type": "boolean",
            "default": false,
            "description": "Block multi-agent sync when SKILL.md lint reports errors."
          },
          "claudeSkills.lint.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Lint SKILL.md frontmatter (name, description, size) on workspace skill sync."
          },
          "claudeSkills.lint.maxDescriptionLength": {
            "type": "number",
            "default": 500,
            "description": "Warn when frontmatter description exceeds this length."
          },
          "claudeSkills.lint.maxSkillBytes": {
            "type": "number",
            "default": 262144,
            "description": "Warn when SKILL.md exceeds this size (bytes)."
          }
        }
      },
      {
        "id": "optimizer",
        "title": "Optimizer",
        "order": 6,
        "properties": {
          "claudeSkills.optimizer.agentSavingsRatio": {
            "type": "number",
            "default": 0.7,
            "minimum": 0,
            "maximum": 1,
            "description": "Suggest agent switch when alternate agent cost is below this fraction of Claude cost."
          },
          "claudeSkills.optimizer.autoApply": {
            "type": "boolean",
            "default": false,
            "description": "Automatically disable expensive rarely-used skills and apply safe optimizations (disable/unused only, max 3 per 30 min)."
          },
          "claudeSkills.optimizer.disableCostPerUseUsd": {
            "type": "number",
            "default": 1,
            "minimum": 0,
            "description": "Suggest disabling a skill when attributed cost per use exceeds this (USD)."
          },
          "claudeSkills.optimizer.disableMaxRuns": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "description": "Pair with disableCostPerUseUsd — only suggest disable when runs are below this count."
          },
          "claudeSkills.optimizer.unusedIdleDays": {
            "type": "number",
            "default": 7,
            "minimum": 1,
            "description": "Suggest disabling skills with no usage for at least this many days."
          },
          "claudeSkills.optimizer.unusedMinCostUsd": {
            "type": "number",
            "default": 0.5,
            "minimum": 0,
            "description": "Minimum attributed cost before idle-day unused suggestions appear."
          },
          "claudeSkills.optimizer.weeklyBudgetUsd": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "description": "Weekly spend cap for predictive alerts (0 = daily budget x 7)."
          }
        }
      },
      {
        "id": "search",
        "title": "Search",
        "order": 7,
        "properties": {
          "claudeSkills.search.sortBy": {
            "type": "string",
            "enum": [
              "relevance",
              "lowest_cost",
              "highest_roi",
              "best_value"
            ],
            "default": "relevance",
            "description": "Skills library tree sort order."
          }
        }
      },
      {
        "id": "archival",
        "title": "Archival",
        "order": 8,
        "properties": {
          "claudeSkills.archival.autoArchive": {
            "type": "boolean",
            "default": false,
            "description": "Automatically archive qualifying skills (moves to skills-archived, not deleted)."
          },
          "claudeSkills.archival.costPerUse": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "description": "Archive if cost per use exceeds this USD and idle 14+ days."
          },
          "claudeSkills.archival.noUsageDays": {
            "type": "number",
            "default": 30,
            "minimum": 7,
            "description": "Archive skills unused for this many days (when auto-archive enabled)."
          }
        }
      },
      {
        "id": "emergency",
        "title": "Emergency",
        "order": 9,
        "properties": {
          "claudeSkills.emergency.hardLimitUsd": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "description": "Absolute daily spend limit that triggers emergency cutoff."
          },
          "claudeSkills.emergency.perSkillLimitUsd": {
            "type": "number",
            "default": 3,
            "minimum": 0,
            "description": "When cutoff triggers, disable only skills with attributed cost at or above this threshold (restores prior overrides on reset)."
          }
        }
      },
      {
        "id": "benchmarks",
        "title": "Benchmarks",
        "order": 10,
        "properties": {
          "claudeSkills.benchmarks.downloadUrl": {
            "type": "string",
            "default": "",
            "description": "Optional HTTPS endpoint to download community benchmarks weekly."
          },
          "claudeSkills.benchmarks.optIn": {
            "type": "boolean",
            "default": false,
            "description": "Opt in to anonymized benchmark upload."
          },
          "claudeSkills.benchmarks.uploadUrl": {
            "type": "string",
            "default": "",
            "description": "Optional HTTPS endpoint for anonymized benchmark upload."
          }
        }
      },
      {
        "id": "telemetry",
        "title": "Telemetry",
        "order": 11,
        "properties": {
          "claudeSkills.telemetry.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Send anonymous local health metrics (activation counts, feature usage) to ~/.claude/learning/health-metrics.json only — no network upload unless you add your own exporter."
          }
        }
      },
      {
        "id": "weeklyReport",
        "title": "Weekly Report",
        "order": 12,
        "properties": {
          "claudeSkills.weeklyReport.dayOfWeek": {
            "type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 6,
            "description": "Day to send the report (0=Sunday, 1=Monday, ...)."
          },
          "claudeSkills.weeklyReport.emailSubject": {
            "type": "string",
            "default": "Weekly AI Agent Usage Report",
            "description": "Email subject prefix for the weekly AI usage report."
          },
          "claudeSkills.weeklyReport.emailTo": {
            "type": "string",
            "default": "",
            "description": "Override email recipient. Empty = discovered via Configure Weekly Report Email (GitHub/GitLab token)."
          },
          "claudeSkills.weeklyReport.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Send a weekly AI agent usage report (off until you run Configure Weekly Report Email; requires VS Code open at scheduled time)."
          },
          "claudeSkills.weeklyReport.hour": {
            "type": "number",
            "default": 9,
            "minimum": 0,
            "maximum": 23,
            "description": "Local hour to send the weekly report."
          },
          "claudeSkills.weeklyReport.minute": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 59,
            "description": "Local minute to send the weekly report."
          },
          "claudeSkills.weeklyReport.smtpHost": {
            "type": "string",
            "default": "",
            "description": "SMTP host for direct email (or set CLAUDE_SKILLS_SMTP_HOST)."
          },
          "claudeSkills.weeklyReport.smtpPassword": {
            "type": "string",
            "default": "",
            "description": "SMTP password (or CLAUDE_SKILLS_SMTP_PASSWORD). Prefer env vars over storing secrets in settings."
          },
          "claudeSkills.weeklyReport.smtpPort": {
            "type": "number",
            "default": 587,
            "description": "SMTP port (TLS)."
          },
          "claudeSkills.weeklyReport.smtpUser": {
            "type": "string",
            "default": "",
            "description": "SMTP username (or CLAUDE_SKILLS_SMTP_USER)."
          }
        }
      },
      {
        "id": "skillSetResolver",
        "title": "Skill Set Resolver",
        "order": 13,
        "properties": {
          "claudeSkills.skillSetResolver.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Once per week, install skills that match this workspace and remove library skills that no longer match detect_globs (requires VS Code open at scheduled time)."
          },
          "claudeSkills.skillSetResolver.dayOfWeek": {
            "type": "number",
            "default": 1,
            "minimum": 0,
            "maximum": 6,
            "description": "Day to run the resolver (0=Sunday, 1=Monday, ...)."
          },
          "claudeSkills.skillSetResolver.hour": {
            "type": "number",
            "default": 8,
            "minimum": 0,
            "maximum": 23,
            "description": "Local hour to run the weekly skill set resolver."
          },
          "claudeSkills.skillSetResolver.minute": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "maximum": 59,
            "description": "Local minute to run the weekly skill set resolver."
          },
          "claudeSkills.skillSetResolver.installRelevant": {
            "type": "boolean",
            "default": true,
            "description": "Install library skills whose detect_globs match files in this workspace."
          },
          "claudeSkills.skillSetResolver.removeIrrelevant": {
            "type": "boolean",
            "default": true,
            "description": "Remove installed library skills that no longer match this workspace (never removes project-local skills)."
          },
          "claudeSkills.skillSetResolver.keepActiveSkills": {
            "type": "boolean",
            "default": true,
            "description": "Keep skills with active usage (2+ runs in the last 30 days) even when detect_globs no longer match."
          },
          "claudeSkills.skillSetResolver.protectedSkills": {
            "type": "array",
            "items": { "type": "string" },
            "default": [
              "self-learning",
              "skill-usage-insights",
              "file-style-conventions",
              "skill-official-updater"
            ],
            "description": "Library skills never removed automatically."
          },
          "claudeSkills.skillSetResolver.usageRules.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Apply usage/session/token/cost rules when resolving the skill set (works with the weekly scheduler)."
          },
          "claudeSkills.skillSetResolver.usageRules.removeNeverUsed": {
            "type": "boolean",
            "default": false,
            "description": "Remove installed library skills with zero recorded sessions in runs.jsonl."
          },
          "claudeSkills.skillSetResolver.usageRules.removeNeverUsedEvenIfRelevant": {
            "type": "boolean",
            "default": true,
            "description": "When removeNeverUsed is on, also remove unused skills that still match detect_globs (reduces skill catalog token load)."
          },
          "claudeSkills.skillSetResolver.usageRules.removeIdleSkills": {
            "type": "boolean",
            "default": false,
            "description": "Remove skills idle for at least unusedIdleDays with attributed cost ≥ minAttributedCostUsd."
          },
          "claudeSkills.skillSetResolver.usageRules.unusedIdleDays": {
            "type": "number",
            "default": 14,
            "minimum": 1,
            "description": "Days since last use before idle removal applies."
          },
          "claudeSkills.skillSetResolver.usageRules.minAttributedCostUsd": {
            "type": "number",
            "default": 0.5,
            "minimum": 0,
            "description": "Minimum attributed cost (USD) before idle or cost-based removal."
          },
          "claudeSkills.skillSetResolver.usageRules.removeStaleLowUsage": {
            "type": "boolean",
            "default": false,
            "description": "Remove low-usage skills idle for at least lowUsageIdleDays."
          },
          "claudeSkills.skillSetResolver.usageRules.lowUsageIdleDays": {
            "type": "number",
            "default": 30,
            "minimum": 1,
            "description": "Days since last use before stale low-usage removal."
          },
          "claudeSkills.skillSetResolver.usageRules.removeBySessions": {
            "type": "boolean",
            "default": false,
            "description": "Remove skills with fewer than minSessionsToKeep recorded sessions."
          },
          "claudeSkills.skillSetResolver.usageRules.minSessionsToKeep": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "description": "Keep skills with at least this many runs.jsonl sessions (when removeBySessions is on)."
          },
          "claudeSkills.skillSetResolver.usageRules.removeByTokens": {
            "type": "boolean",
            "default": false,
            "description": "Remove skills whose total recorded tokens fall below minTotalTokensToKeep."
          },
          "claudeSkills.skillSetResolver.usageRules.minTotalTokensToKeep": {
            "type": "number",
            "default": 50000,
            "minimum": 0,
            "description": "Minimum runs.jsonl token total to keep a skill (when removeByTokens is on)."
          },
          "claudeSkills.skillSetResolver.usageRules.removeByCost": {
            "type": "boolean",
            "default": false,
            "description": "Remove expensive low-use skills when attributed cost per session exceeds maxCostPerUseUsd."
          },
          "claudeSkills.skillSetResolver.usageRules.maxCostPerUseUsd": {
            "type": "number",
            "default": 1,
            "minimum": 0,
            "description": "Max attributed USD per session before cost-based removal (paired with maxRunsForCostRemoval)."
          },
          "claudeSkills.skillSetResolver.usageRules.maxRunsForCostRemoval": {
            "type": "number",
            "default": 5,
            "minimum": 0,
            "description": "Only cost-remove skills with at most this many sessions."
          },
          "claudeSkills.skillSetResolver.usageRules.requireReliableAttribution": {
            "type": "boolean",
            "default": true,
            "description": "Only apply idle/cost rules when per-skill attribution is reliable (recommended)."
          },
          "claudeSkills.skillSetResolver.usageRules.archiveInsteadOfRemove": {
            "type": "boolean",
            "default": false,
            "description": "Move removed skills to .claude/skills-archived/ instead of deleting (requires skillArchival feature)."
          },
          "claudeSkills.skillSetResolver.usageRules.skipHighCostInstall": {
            "type": "boolean",
            "default": false,
            "description": "Do not auto-install high cost_estimate skills unless they already have recorded usage."
          }
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSkills.openExtensionSettings",
          "when": "view == claudeSkillsView",
          "group": "navigation@0"
        },
        {
          "command": "claudeSkills.refresh",
          "when": "view == claudeSkillsView",
          "group": "navigation@1"
        },
        {
          "command": "claudeSkills.previewForWorkspace",
          "when": "view == claudeSkillsView",
          "group": "navigation@2"
        },
        {
          "command": "claudeSkills.generateForWorkspace",
          "when": "view == claudeSkillsView",
          "group": "1_install"
        },
        {
          "command": "claudeSkills.generateAllForWorkspace",
          "when": "view == claudeSkillsView",
          "group": "1_install"
        },
        {
          "command": "claudeSkills.installLibraryToGlobal",
          "when": "view == claudeSkillsView",
          "group": "2_global"
        },
        {
          "command": "claudeSkills.installLibraryToAllAgents",
          "when": "view == claudeSkillsView",
          "group": "2_global"
        },
        {
          "command": "claudeSkills.showAgentCapabilities",
          "when": "view == claudeSkillsView",
          "group": "2_global"
        },
        {
          "command": "claudeSkills.syncWorkspaceToAgents",
          "when": "view == claudeSkillsView",
          "group": "2_global"
        },
        {
          "command": "claudeSkills.showUsageStats",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.configureWeeklyReportEmail",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.sendWeeklyReport",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.showCostDashboard",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.showOptimizationSuggestions",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.manageFeatures",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.cycleSkillSort",
          "when": "view == claudeSkillsView",
          "group": "navigation@3"
        },
        {
          "command": "claudeSkills.showBranchProfiles",
          "when": "view == claudeSkillsView && claudeSkills.branchProfilesEnabled",
          "group": "navigation@4"
        },
        {
          "command": "claudeSkills.saveBranchProfile",
          "when": "view == claudeSkillsView && claudeSkills.branchProfilesEnabled",
          "group": "navigation@5"
        },
        {
          "command": "claudeSkills.applyBranchProfile",
          "when": "view == claudeSkillsView && claudeSkills.branchProfilesEnabled",
          "group": "navigation@6"
        },
        {
          "command": "claudeSkills.installSessionWatchHook",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.installCostControlHooks",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.cycleBudgetMode",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.cycleContextFocusLevel",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        },
        {
          "command": "claudeSkills.cyclePracticalFocusLevel",
          "when": "view == claudeSkillsView",
          "group": "3_usage"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSkills.installSkillToWorkspace",
          "when": "view == claudeSkillsView && viewItem =~ /^skill-(available|unavailable)/",
          "group": "inline"
        },
        {
          "command": "claudeSkills.disableSkillLocally",
          "when": "view == claudeSkillsView && viewItem =~ /-local-on$/",
          "group": "inline"
        },
        {
          "command": "claudeSkills.enableSkillLocally",
          "when": "view == claudeSkillsView && viewItem =~ /-local-off$/",
          "group": "inline"
        },
        {
          "command": "claudeSkills.openSkill",
          "when": "view == claudeSkillsView && viewItem =~ /^skill-/",
          "group": "1_open"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run sync-skills && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run sync-skills",
    "test": "vitest run",
    "sync-skills": "node ./scripts/sync-skills-library.js",
    "package": "npm run sync-skills && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "gallery": [
    {
      "path": "images/screenshot-skills-tree.png",
      "caption": "Skills tree with stack detection and per-skill enable toggles"
    },
    {
      "path": "images/screenshot-dashboard.png",
      "caption": "Cost Intelligence Dashboard with agent spend and attribution setup"
    },
    {
      "path": "images/screenshot-setup-wizard.png",
      "caption": "Setup wizard for global library, workspace skills, and optional cost hooks"
    },
    {
      "path": "images/screenshot-budget-controls.png",
      "caption": "Budget mode status bar and daily spend limits"
    }
  ]
}
